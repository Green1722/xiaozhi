# Example only. Copy to .env, replace locally, never commit actual credentials.
HEALTH_API_KEY=REPLACE_ME
DATABASE_URL=sqlite:///./data/exams.db
# Dedicated IoTDA signature Token, different from HEALTH_API_KEY (24-32 alphanumeric chars).
IOTDA_FORWARD_KEY=
# Explicit device bindings; example values only. Empty disables forwarding.
IOTDA_DEVICES_JSON={}
# Shape: {"DEVICE_ID":{"app_id":"APP_ID","product_id":"PRODUCT_ID","instrument_id":"DEMO-01","source":"synthetic"}}
# RDS alternative: mysql+pymysql://USER:URL_ENCODED_PASSWORD@PRIVATE_HOST:3306/xiaozhi?charset=utf8mb4
# RDS_SSL_CA=/run/secrets/rds-ca.pem
# Copy the exact endpoint and available model id from your MaaS console.
MAAS_CHAT_URL=
MAAS_MODEL=
MAAS_API_KEY=
