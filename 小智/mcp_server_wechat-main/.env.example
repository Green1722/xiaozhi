# 微信MCP服务配置文件示例
# 复制此文件为 .env 并根据需要修改配置

# ==================== MCP服务器配置 ====================
# 服务监听地址（默认：0.0.0.0 监听所有网卡）
MCP_HOST=0.0.0.0

# 服务监听端口（默认：3000）
MCP_PORT=3000

# 聊天记录保存路径
MCP_FOLDER_PATH=C:\Users\Administrator\Documents\mcp_wechat_history

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
MCP_LOG_LEVEL=INFO

# ==================== MCP Pipe配置（可选） ====================
# WebSocket端点地址（用于mcp_pipe.py连接远程服务）
# MCP_ENDPOINT=ws://your-server:8080/ws

# MCP配置文件路径（可选，默认使用当前目录的mcp_config.json）
# MCP_CONFIG=./mcp_config.json
